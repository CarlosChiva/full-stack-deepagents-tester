# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in the values before running the application
# ==============================================================================

# ---- Authentication ----
# Secret key for JWT token signing and verification (minimum 32 characters)
# Use a strong random string generated by: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars

# JWT signing algorithm. Supported: HS256 (HMAC), RS256 (RSA), ES256 (ECDSA)
# Defaults to HS256 which requires a symmetric key (JWT_SECRET)
JWT_ALGORITHM=HS256

# ---- AI Agent Configuration ----
# LLM model identifier for the DeepAgent bridge
# Format: <provider>.<model-name>
# Examples: openai:gpt-4.1, anthropic:claude-sonnet-4-20250514, ollama:llama3.1
AGENT_MODEL=openai:gpt-4.1

# API key for the AI provider (e.g., OpenAI)
# Get yours from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Base URL for the OpenAI API (e.g., for Azure, Ollama, or other compatible providers)
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Model temperature (0.0 – 1.0). Higher values make output more random, lower values more deterministic.
MODEL_TEMPERATURE=0.7

# ---- Agent Runtime Settings ----
# Maximum number of reasoning steps an agent can take in a single invocation
# Higher values allow deeper reasoning but cost more tokens and take longer
# Recommended: 5-15 depending on task complexity
RECURSION_LIMIT=10

# ==============================================================================
